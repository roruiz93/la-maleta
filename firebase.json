{
  "hosting": {
    "site": "la-maleta-e038c",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "vite.config.js",
      "simple-server.js",
      "test-translations.html",
      "**/*.md",
      "vercel.json"
    ],
    "headers": [
      {
        "source": "src/**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
