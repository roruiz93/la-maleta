rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuperAdmin() { return isLoggedIn() && myRole() == 'superadmin'; }
    function isAdmin() { return isLoggedIn() && myRole() == 'admin'; }
    function isEditor() { return isLoggedIn() && myRole() in ['superadmin','admin','editor']; }

    // Sitio (textos, colores, imágenes, settings)
    match /site/content  { allow read: if true; allow write: if isEditor(); }
    match /site/colors   { allow read: if true; allow write: if isEditor(); }
    match /site/images   { allow read: if true; allow write: if isEditor(); }
    match /site/settings { allow read: if true; allow write: if isEditor(); }

    // Destinos
    match /destinos/{id}     { allow read: if true; allow write: if isEditor(); }

    // Experiencias
    match /experiencias/{id} { allow read: if true; allow write: if isEditor(); }

    // Blog posts
    match /posts/{id}        { allow read: if true; allow write: if isEditor(); }

    // Consultas — cualquiera puede crear (formulario público), pero solo con
    // los campos, tipos y tamaños que manda la web. Solo el equipo las lee.
    function strOk(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }
    function optStr(d, k, maxLen) {
      return !(k in d) || strOk(d[k], 0, maxLen);
    }
    function consultaValida(d) {
      return d.keys().hasOnly(['nombre','email','tel','asunto','mensaje','origen','destino','leida','fecha','acepta'])
        && strOk(d.nombre, 2, 100)
        && strOk(d.email, 5, 200)
        && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && optStr(d, 'tel', 30)
        && optStr(d, 'asunto', 150)
        && optStr(d, 'mensaje', 3000)
        && optStr(d, 'origen', 30)
        && optStr(d, 'destino', 150)
        && d.leida == false
        // Consentimiento RGPD (casilla de la política de privacidad)
        && d.acepta == true
        && strOk(d.fecha, 10, 40);
    }

    match /consultas/{id} {
      allow create: if id.matches('consulta_[0-9]{10,16}') && consultaValida(request.resource.data);
      allow read, delete: if isEditor();
      // El admin solo marca como leída
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
    }

    // Usuarios
    // Cualquiera puede crearse una cuenta con la API pública de Auth: estar
    // logueado no alcanza. Cada uno lee su perfil (el login busca su rol), el
    // superadmin lee todos y el admin solo los editores (renderUsuarios).
    match /users/{uid} {
      allow read:   if isLoggedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || (isAdmin() && resource.data.role == 'editor')
      );
      allow create: if request.resource.data.keys().hasOnly(['email','name','role','createdAt'])
        && (
          (isSuperAdmin() && request.resource.data.role in ['editor','admin','superadmin'])
          || (isAdmin() && request.resource.data.role == 'editor')
        );
      allow delete: if isSuperAdmin() && uid != request.auth.uid;
      allow update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
